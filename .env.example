NODE_ENV=development
PORT=3333
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=flash_erp
DB_PASSWORD=flash_erp
DB_DATABASE=flash_erp
DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=false only for a trusted private CA setup.
DB_POOL_MAX=20
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave empty for the bundled same-origin frontend proxy; set only for an external API.
VITE_API_URL=
OUTBOX_MAX_ATTEMPTS=20
TEST_DB_DATABASE=flash_erp_test
# Required only when creating the first admin with npm run seed:admin (12+ characters).
ADMIN_PASSWORD=change-me-before-seeding
# Optional local add-on settings.
# FLASHERP_PLUGIN_DIR=./plugins
# FLASHERP_ENABLED_PLUGINS=plugin-a,plugin-b
