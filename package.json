{
  "name": "flash-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "frontend"
  ],
  "overrides": {
    "multer": "2.4.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node dist/src/main.js",
    "start:dev": "tsx watch src/main.ts",
    "build": "tsc && node dist/scripts/resolve_compiled_aliases.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "architecture:check": "node --experimental-strip-types scripts/check_module_boundaries.ts",
    "make:module": "tsx scripts/make_module.ts",
    "seed:admin": "tsx scripts/seed_admin.ts"
  },
  "imports": {
    "#platform/*": "./src/platform/*.js",
    "#modules/*": "./src/modules/*.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/event-emitter": "^12.0.0",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/typeorm": "^11.0.0",
    "@orpc/client": "1.15.5",
    "@orpc/contract": "1.15.5",
    "@orpc/nest": "1.15.5",
    "@orpc/openapi": "1.15.5",
    "@orpc/openapi-client": "1.15.5",
    "@orpc/server": "1.15.5",
    "@orpc/valibot": "1.15.5",
    "luxon": "^3.7.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.21",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.0",
    "fast-check": "^4.9.0",
    "prettier": "^3.5.0",
    "tsx": "^4.19.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^5.0.0"
  }
}
